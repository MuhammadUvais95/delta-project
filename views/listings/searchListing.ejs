 <% layout("/layouts/boilerplate") -%>   <!-- to add ejsmate to every page--> 
 
      <!-- listing image  -->
       <% if(searchListings.length > 0 ) { %>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-5">
      <% for(let listing of searchListings) {  %>
        <a href="/listings/<%= listing._id %>" class="listing-link">   
            
             <div class="card col listing-card">
                  <img src="<%=listing.image.url%>" class="card-img-top object-fit-cover" alt="listing_image" style="height: 20rem;" >
                   <div class="card-img-overlay"></div>  
                   <div class="card-body">
                       <p class="card-text">
                         <b><%=listing.title%></b> <br>
                          &#8377;<%=listing.price?.toLocaleString("en-IN")%> / night
                          <i class="tax-info"> &nbsp; &nbsp;+18% GST</i>
                       </p>
                 </div>
              </div>
              </a>

           <% } %> 
          </div>
          <% } else { %>
            <div class="text-center mt-5">
                  <h3>No Listings Found</h3>
                  <p class="text-muted">No results Found for <b>"<%= query %>"</b></p>
                  <a href="/listings" class=" btn btn-outline-primary mt-2">Explore All Listings</a>
            </div>
            <% } %>


       


