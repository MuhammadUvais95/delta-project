<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"> <i class="fa-regular fa-compass fs-3"></i></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

      
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

      <div class="navbar-nav ms-auto">
    <form action="/search" method="GET" class="d-flex" role="search">
        <!-- Wrapper for positioning the suggestion box -->
        <div class="position-relative me-2 flex-grow-1">
            <input 
                class="form-control search-input" 
                type="search" 
                name="query" 
                autocomplete="off" 
                id="searchInput" 
                value="<%= typeof query !== 'undefined' ? query: '' %>" 
                placeholder="Search destinations"
            />
            <!-- Suggestions dropdown container -->
            <div id="suggestionsBox" class="list-group position-absolute w-100" style="z-index: 1050;"></div>
        </div>
        
        <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i> Search
        </button>
    </form>
</div>



       <div class="navbar-nav ms-auto mt-2 mt-md-0">
         <a class="nav-link" href="/listings/new">Airbnb your home</a>
        <% if(!currUser) {  %>
        <a class="nav-link active"href="/signup"> <b>SignUp</b></a>
        <a class="nav-link" href="/login"><b>Login</b></a>
        <% } %>
        <% if(currUser) {  %>
        <a class="nav-link" href="/logout"><b>Logout</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>



<script>
  const searchInput = document.getElementById("searchInput");
  const suggestionsBox = document.getElementById("suggestionsBox");
  searchInput.addEventListener("input", async() => {
  const query = searchInput.value.trim();
  if(!query){
    suggestionsBox.innerHTML = "";
    return;
  }
  try{
  const response = await fetch(`/suggestions?query=${query}`)
  const listings = await response.json();
  suggestionsBox.innerHTML = "";

  listings.forEach(listing => {
    const item = document.createElement("a");
    item.classList.add(
      "list-group-item",
      "list-group-item-action"
    );
    item.href = `/listings/${listing._id}`;
    item.textContent = listing.title;

    suggestionsBox.appendChild(item);
  })
 }catch(err) {
  console.log("Error is ::", err);
}
  });

</script>




